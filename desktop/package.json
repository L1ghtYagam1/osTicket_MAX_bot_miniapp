{
  "name": "provence-support-desktop",
  "productName": "Provence Support",
  "version": "1.0.0",
  "description": "Десктопное приложение поддержки Provence (обёртка над web app osTicket MAX bot)",
  "main": "main.js",
  "author": "Provence",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ru.ukprovence.support.desktop",
    "productName": "Provence Support",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Provence Support"
    }
  }
}
